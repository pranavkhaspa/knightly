{
  // Trusted OpenCode server policy for NightShift.
  // Uses OpenCode's real `permission` config. The previous file used a
  // `permissions`/`policies` array schema that OpenCode does not define.
  // Everything the agent needs is explicitly "allow": a headless server cannot
  // answer an "ask" prompt, so any "ask" permission would hang the session.
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "deny",
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
