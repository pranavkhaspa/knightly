[Unit]
Description=NightShift FalkorDB-first edge agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nightshift
Group=nightshift
ExecStart=/usr/local/bin/nightshift
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
