# NightShift is graph-first: FalkorDB stores all durable product state.
# The edge process may use a temporary replay spool, but it is never a
# source of truth for profile, memory, recommendations, tasks, or actions.

NIGHTSHIFT_LISTEN=127.0.0.1:8080
NIGHTSHIFT_ENV=development
# Set a stable unique value for a named host. Containers fall back to HOSTNAME
# when this is omitted, which keeps scaled instances distinguishable.
NIGHTSHIFT_INSTANCE_ID=local-dev
NIGHTSHIFT_DATA_DIR=./data

# Use redis://, rediss://, falkor://, or falkors://.
FALKORDB_URL=redis://127.0.0.1:6379
FALKORDB_CONTROL_GRAPH=nightshift_control
FALKORDB_GRAPH=nightshift_u_demo
FALKORDB_QUERY_TIMEOUT_MS=5000

# External writes remain disabled by default. If enabled, only explicitly
# approved local-plan execution is available in this MVP.
NIGHTSHIFT_ACTIONS_ENABLED=false
