# NightShift is graph-first: FalkorDB stores all durable product state.
# The edge process may use a temporary replay spool, but it is never a
# source of truth for profile, memory, recommendations, tasks, or actions.

NIGHTSHIFT_LISTEN=127.0.0.1:8080
NIGHTSHIFT_ENV=development
# Set a stable unique value for a named host. Containers fall back to HOSTNAME
# when this is omitted, which keeps scaled instances distinguishable.
NIGHTSHIFT_INSTANCE_ID=local-dev
NIGHTSHIFT_DATA_DIR=./data
NIGHTSHIFT_TENANT_ID=tenant_demo
NIGHTSHIFT_USER_ID=user_demo
NIGHTSHIFT_PROJECT_ID=project_nightshift

# Use redis://, rediss://, falkor://, or falkors://.
FALKORDB_URL=redis://127.0.0.1:6379
FALKORDB_CONTROL_GRAPH=nightshift_control
FALKORDB_GRAPH=nightshift_u_demo
FALKORDB_QUERY_TIMEOUT_MS=5000

# Optional no-card web search through a private/self-hosted SearXNG instance
# with JSON output enabled (search.formats: [html, json]).
# Local Compose ships a pinned SearXNG sidecar bound to 127.0.0.1:8888, so set:
#   NIGHTSHIFT_SEARCH_URL=http://127.0.0.1:8888
# Loopback HTTP is accepted for local development; remote instances require
# HTTPS unless NIGHTSHIFT_SEARCH_ALLOW_HTTP is explicitly enabled.
NIGHTSHIFT_SEARCH_URL=
# Only set true for an explicitly local development endpoint. Remote
# SearXNG instances must use HTTPS.
NIGHTSHIFT_SEARCH_ALLOW_HTTP=false

# Gmail and Google Calendar read-only (P0). The Gmail OAuth scope requested is
# always https://www.googleapis.com/auth/gmail.readonly and the Calendar scope is
# always https://www.googleapis.com/auth/calendar.readonly. OAuth refresh tokens
# are stored only in NIGHTSHIFT_MAIL_CREDENTIALS_FILE (owner-only file), never in
# FalkorDB, logs, prompts, or artifacts. Leave GMAIL_CLIENT_ID empty to keep the
# Google providers disabled. The same client and redirect are shared by Gmail and
# Calendar.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URL=http://127.0.0.1:8080/api/v1/mail/accounts/callback
NIGHTSHIFT_MAIL_CREDENTIALS_FILE=./data/mail-credentials.json

# IANA timezone used to normalize calendar windows and event times. The default
# is UTC; invalid values are rejected at startup.
NIGHTSHIFT_TIMEZONE=UTC

# Optional approval-gated reminder webhook sink. Leave empty to keep external
# reminder delivery disabled; the inbox sink always works without configuration.
# A configured webhook is never delivered by an automatic tick: it requires an
# explicit POST /api/v1/reminders/{id}/approve. Non-loopback URLs must use HTTPS.
NIGHTSHIFT_REMINDER_WEBHOOK_URL=

# GitHub integration. GITHUB_TOKEN is a fine-grained personal access token (or
# GitHub App installation token) with least privilege: read-only for the objects
# NightShift reports on, plus issues/pull-requests/contents write only if
# approved writes are wanted. The token is never stored in FalkorDB, logs, or
# prompts. GITHUB_REPOSITORIES is the comma-separated owner/name allowlist that
# both reads and approved writes are restricted to. Leave GITHUB_TOKEN empty to
# keep the GitHub provider disabled.
GITHUB_TOKEN=
GITHUB_REPOSITORIES=
GITHUB_API_BASE=https://api.github.com

# External writes remain disabled by default. If enabled, only explicitly
# approved actions run: local-plan files and allowlisted GitHub issue/branch/
# commit/push/PR operations. Force-push and auto-merge are always refused.
NIGHTSHIFT_ACTIONS_ENABLED=false

# Keep the daemon on loopback unless it is behind a trusted TLS/authenticated
# proxy. A non-loopback NIGHTSHIFT_LISTEN is rejected unless either this token
# or the complete username/password pair below is configured.
NIGHTSHIFT_AUTH_TOKEN=
NIGHTSHIFT_AUTH_USERNAME=
NIGHTSHIFT_AUTH_PASSWORD=

# These are trusted deployment identities. They are attached by middleware and
# must never be accepted from request headers, query parameters, or JSON bodies.
# They apply to loopback-only single-user operation.
NIGHTSHIFT_AUTH_TENANT_ID=tenant_demo
NIGHTSHIFT_AUTH_USER_ID=user_demo
NIGHTSHIFT_AUTH_APPROVER_ID=user_demo

# Verified per-request identity for multi-user deployments. Configure exactly one
# source. When set, the tenant/user/approver come from verified evidence and the
# static identities above are only the installation fallback.

# OIDC bearer tokens verified against the provider JWKS (iss/aud/exp/nbf).
NIGHTSHIFT_OIDC_ISSUER=
NIGHTSHIFT_OIDC_AUDIENCE=
NIGHTSHIFT_OIDC_JWKS_URL=
NIGHTSHIFT_OIDC_TENANT_CLAIM=tenant

# Or a trusted proxy that signs the identity headers with this secret:
# HMAC-SHA256 over "tenant\nuser\napprover\ntimestamp". Header names below are
# optional overrides.
NIGHTSHIFT_TRUSTED_PROXY_SECRET=
NIGHTSHIFT_TRUSTED_PROXY_TENANT_HEADER=
NIGHTSHIFT_TRUSTED_PROXY_USER_HEADER=
NIGHTSHIFT_TRUSTED_PROXY_APPROVER_HEADER=
NIGHTSHIFT_TRUSTED_PROXY_SIGNATURE_HEADER=
NIGHTSHIFT_TRUSTED_PROXY_TIMESTAMP_HEADER=

# Observability. Logs are structured JSON by default and every attribute value
# is redacted. GET /metrics renders bounded Prometheus counters/histograms; keep
# it behind authentication unless the scrape network is trusted. Setting an OTLP
# endpoint enables non-blocking OTLP/HTTP JSON metric export.
NIGHTSHIFT_LOG_FORMAT=json
NIGHTSHIFT_LOG_LEVEL=info
NIGHTSHIFT_OTLP_ENDPOINT=
NIGHTSHIFT_METRICS_PUBLIC=false

# Optional Dev2 coding integration. Leave OpenCode URL blank to disable it.
# Only explicitly allowlisted repositories can be used for coding tasks.
# OpenCode's server must run with a trusted policy that denies pushes and
# external-directory access; a Git worktree alone is not a shell sandbox.
NIGHTSHIFT_OPENCODE_URL=
# Native OpenCode server authentication uses Basic auth. Leave both blank for a loopback-only local server.
NIGHTSHIFT_OPENCODE_SERVER_USERNAME=
NIGHTSHIFT_OPENCODE_SERVER_PASSWORD=
# Optional Bearer token only when a trusted reverse proxy explicitly requires it.
NIGHTSHIFT_OPENCODE_TOKEN=
NIGHTSHIFT_OPENCODE_MODEL=opencode/big-pickle
# Set true only after applying the trusted server policy documented in docs/opencode.md.
NIGHTSHIFT_OPENCODE_POLICY_CONFIRMED=false
NIGHTSHIFT_WORKSPACE_ROOT=../nightshift-workspaces
# JSON array of canonical local repository paths, e.g. ["/home/user/src/payment-service"]
NIGHTSHIFT_ALLOWED_REPOSITORIES_JSON=[]
# JSON map from NightShift project ID to its local checkout (must also be allowlisted).
# {"project_nightshift":"/home/user/src/nightshift"}
NIGHTSHIFT_CODING_PROJECT_REPOSITORIES_JSON={}
# JSON map from NightShift project ID to an argv array (never a shell string), e.g.
# {"project_nightshift":["go","test","./..."]}
NIGHTSHIFT_CODING_TEST_COMMANDS_JSON={}
NIGHTSHIFT_CODING_RUN_TIMEOUT_SECONDS=7200
